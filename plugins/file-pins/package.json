{
  "name": "bb-plugin-file-pins",
  "version": "0.1.0",
  "description": "Keep local files within reach in each bb thread.",
  "type": "module",
  "files": ["dist", "README.md", "PLUGIN_OVERVIEW.md", "skills"],
  "scripts": {
    "build": "node ../../tooling/build-plugin.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {"bb": ">=0.43.4", "bbPluginSdk": ">=0.5.9"},
  "bb": {
    "name": "File Pins",
    "description": "Pin local files to a thread and open them from a persistent strip above the chat composer.",
    "branding": {"icon": "Pin"},
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": ["skills"]
  },
  "dependencies": {"zod": "^4.3.6"},
  "devDependencies": {
    "@get-bb/plugin-sdk": "file:../../tooling/vendor/get-bb-plugin-sdk-0.5.9.tgz",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
