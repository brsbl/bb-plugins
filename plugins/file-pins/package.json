{
  "name": "bb-plugin-file-pins",
  "version": "0.1.7",
  "description": "Keep local files and web links within reach in each bb thread.",
  "type": "module",
  "files": [
    "assets",
    "dist",
    "docs",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../tooling/build-plugin.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bb": ">=0.43.4",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Pinned Files & Links",
    "description": "Pin local files and web links to a thread and open them from a persistent strip above the chat composer.",
    "branding": {
      "icon": "./assets/file-pins.svg",
      "logo": {
        "light": "./assets/file-pins.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@brsbl/bb-website-icons": "0.1.0",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "file:../../tooling/vendor/get-bb-plugin-sdk-0.5.9.tgz",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "sonner": "^1.7.4",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@types/react-dom": "^19.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-tooltip": "^1.2.12"
  }
}
