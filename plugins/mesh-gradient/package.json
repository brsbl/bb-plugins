{
  "name": "bb-plugin-mesh-gradient",
  "version": "0.1.0",
  "description": "Design, preview, and export mesh gradients from bb.",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "assets",
    "dist",
    "docs",
    "themes",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tooling/build-plugin.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bb": ">=0.0.34",
    "bbPluginSdk": "^0.5.0"
  },
  "bb": {
    "name": "Mesh Gradient",
    "description": "Design, preview, and export mesh gradients from bb.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [],
    "themes": [
      {
        "id": "aurora",
        "name": "Mesh Aurora",
        "description": "Green-to-violet, from the aurora palette",
        "css": "./themes/aurora.css"
      },
      {
        "id": "sunset",
        "name": "Mesh Sunset",
        "description": "Warm amber and rose, from the sunset palette",
        "css": "./themes/sunset.css"
      },
      {
        "id": "ocean",
        "name": "Mesh Ocean",
        "description": "Teal and indigo, from the ocean palette",
        "css": "./themes/ocean.css"
      },
      {
        "id": "candy",
        "name": "Mesh Candy",
        "description": "Bright pink and violet, from the candy palette",
        "css": "./themes/candy.css"
      },
      {
        "id": "forest",
        "name": "Mesh Forest",
        "description": "Muted greens, from the forest palette",
        "css": "./themes/forest.css"
      },
      {
        "id": "mono",
        "name": "Mesh Mono",
        "description": "Single-hue neutral, from the mono palette",
        "css": "./themes/mono.css"
      }
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-sdk": "file:../../tooling/vendor/bb-plugin-sdk-0.5.0.tgz",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
