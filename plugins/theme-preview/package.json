{
  "name": "bb-plugin-theme-preview",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": ["assets", "dist", "docs", "skills", "README.md"],
  "engines": { "bb": ">=0.38.0", "bbPluginSdk": ">=0.4.6" },
  "bb": {
